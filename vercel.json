{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "llmnesia.com"
        }
      ],
      "destination": "https://www.llmnesia.com/:path*",
      "permanent": true
    },
    {
      "source": "/pricing",
      "has": [
        {
          "type": "query",
          "key": "checkout",
          "value": "success"
        }
      ],
      "destination": "/account?checkout=success",
      "permanent": false
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/privacy-policy.html",
      "destination": "/privacy-policy",
      "permanent": true
    },
    {
      "source": "/contact",
